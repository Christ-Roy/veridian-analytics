# Veridian Analytics — Variables d'environnement
#
# Deux usages :
# 1. Dev local : `cp .env.example .env.local` + remplir
# 2. Prod Dokploy : les valeurs réelles vivent dans Dokploy UI
#    (Settings → Environment) — ne JAMAIS commit de vraies valeurs ici.
# Source de vérité du compose : ./docker-compose.yml

# ───── Node ─────
NODE_ENV=development
PORT=3000

# ───── Auth.js ─────
# Secret signature JWT (32 chars min, openssl rand -base64 32)
AUTH_SECRET=
# URL absolue NextAuth (dev: http://localhost:3000, prod: https://analytics.app.veridian.site)
NEXTAUTH_URL=http://localhost:3000
# En prod uniquement (sinon NextAuth refuse via reverse proxy)
AUTH_TRUST_HOST=true

# ───── Prisma (veridian-core-db) ─────
# Dev : postgresql://veridian:password@localhost:5432/veridian?schema=analytics
# Prod : connection string Postgres mutualisée Veridian, schema=analytics
DATABASE_URL=postgresql://veridian:password@localhost:5432/veridian?schema=analytics

# ───── Clés API ─────
# Clé admin pour provisioning tenants / callback hub (32 chars min)
ADMIN_API_KEY=
# Brevo transactionnel emails (optionnel, laisser vide si pas utilisé)
BREVO_API_KEY=

# ───── Compose Dokploy (prod uniquement) ─────
# Domaine public servi par Traefik (ex: analytics.app.veridian.site)
DOMAIN=
# Tag image GHCR (par défaut "latest" — pin par SHA dans docker-compose.yml)
ANALYTICS_IMAGE_TAG=latest
